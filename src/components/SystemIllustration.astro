---
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg class={`system-illustration signal-${kind}`} viewBox="0 0 440 220" aria-hidden="true">
  <defs>
    <linearGradient id={`metal-${kind}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#25292b" />
      <stop offset="0.55" stop-color="#101314" />
      <stop offset="1" stop-color="#34393a" />
    </linearGradient>
    <filter id={`soft-${kind}`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3.2" />
    </filter>
  </defs>
  <path class="board" d="M32 174 82 40h274l52 134-48 24H82Z" fill={`url(#metal-${kind})`} />
  <path class="board-edge" d="M32 174h376l-48 24H82Z" />
  <g class="pads">
    <rect x="102" y="75" width="72" height="52" rx="4" />
    <rect x="270" y="75" width="72" height="52" rx="4" />
    <rect x="190" y="132" width="64" height="40" rx="4" />
  </g>
  <g class="traces">
    <path d="M56 164h62v-28h20V94h36" />
    <path d="M174 101h52v52h44" />
    <path d="M254 151h46v-24" />
    <path d="M305 75V57h54" />
    <path d="M138 75V56H91" />
  </g>
  <g class="trace-glow" filter={`url(#soft-${kind})`}>
    <path d="M56 164h62v-28h20V94h36" />
    <path d="M174 101h52v52h44" />
    <path d="M254 151h46v-24" />
  </g>
  <g class="vias">
    <circle cx="56" cy="164" r="4" /><circle cx="174" cy="101" r="4" />
    <circle cx="254" cy="151" r="4" /><circle cx="305" cy="75" r="4" />
    <circle cx="138" cy="75" r="4" />
  </g>
</svg>
